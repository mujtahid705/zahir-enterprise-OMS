# Copy to .env.local, or run scripts/setup-supabase.sh to fill it. Values come from the single Supabase project (SPEC §13.0, §13.5, ADR 0002).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_…
SUPABASE_SECRET_KEY=                    # sb_secret_…, server only
DATABASE_URL=                           # transaction pooler (6543), app runtime, server only
DIRECT_DATABASE_URL=                    # session pooler (5432), migrations, server only
SUPABASE_PROJECT_REF=                   # project ref; DB tests refuse to run against any other project
SUPABASE_DB_PASSWORD=                   # database password, server only
